{
  "name": "hole-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "test": "vitest run",
    "test:browser": "node checks/browser.mjs",
    "secrets:check": "node scripts/check-secrets.mjs staged",
    "secrets:history": "node scripts/check-secrets.mjs history",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
